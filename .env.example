# Safe local default: no external API calls and no real money.
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8787
# For a Sandbox run with Vite, set PUBLIC_BASE_URL=http://localhost:5173.

# Public hosting must keep this true: blocks Sandbox payments and Kernel sessions.
# Local, private Sandbox testing requires false.
PUBLIC_DEMO=false
# Optional >=32-character signing secret. If empty, generated in DATA_DIR/.session-key.
SESSION_SECRET=

# demo | paypal-sandbox. Live PayPal is deliberately not supported.
PAYMENTS_MODE=demo
# Private Sandbox-only opt-in; explicit per-agreement confirmation is also required.
ALLOW_SANDBOX_AUTOPILOT=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional Sandbox recipient accounts. Never paste real credentials into chat.
# Alternatively set PAYPAL_PAYOUT_RECIPIENTS to a JSON map of allocation IDs to emails.
PAYPAL_GUIDE_EMAIL=
PAYPAL_TELESCOPE_EMAIL=
PAYPAL_TRANSPORT_EMAIL=
PAYPAL_PAYOUT_RECIPIENTS=

# deterministic | anthropic | gemini. Explicitly choose an available model in your account.
AGENT_MODE=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional Google AI Studio project key; never place it in a VITE_ variable.
# Keep AGENT_MODE=deterministic until the user verifies the project's Free Tier/model quota.
# GEMINI_MODEL is an available model ID chosen in AI Studio, without a models/ prefix or URL.
# First Gemini check: use a EUR 1700 budget, 2 guests and 20 minutes of flexibility.
# Valid supplier quotes can total EUR 1680; EUR 1500 may correctly reject the proposal.
# Key presence alone does not prove inference. Verify 3 supplier requests and returned mode=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# fixtures | aemet. AEMET observations alone do not prove clear skies.
WEATHER_MODE=fixtures
AEMET_API_KEY=
AEMET_STATION_ID=

# Optional controlled browser session. Destination is server-configured, not user input.
KERNEL_API_KEY=
KERNEL_SUPPLIER_URL=

# Metadata only: true only after actual development-tool installation and use.
APIMATIC_CONTEXT_INSTALLED=false
